# ──────────────────────────────────────────────────────────────────────
# 2108Trade Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ── Node Environment ──────────────────────────────────────────────────
# Options: development | production | test
NODE_ENV=production

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Defaults work for local Docker Compose deployment
POSTGRES_USER=2108trade
POSTGRES_PASSWORD=2108trade
POSTGRES_DB=2108trade
POSTGRES_PORT=5432

# Full connection string (auto-generated in docker-compose, override for external DB)
# DATABASE_URL=postgresql://2108trade:2108trade@localhost:5432/2108trade

# ── Redis ─────────────────────────────────────────────────────────────
# Defaults work for local Docker Compose deployment
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Encryption ────────────────────────────────────────────────────────
# REQUIRED. AES-256-GCM key for encrypting broker API credentials at rest.
# Must be exactly 64 hex characters (32 bytes). Missing in production → startup crash.
# Generate with: openssl rand -hex 32
# WARNING: Changing this key will make all existing encrypted credentials unreadable.
#          Use the key_version field for planned key rotation in the future.
ENCRYPTION_KEY=

# ── Application Ports ─────────────────────────────────────────────────
# Docker Compose uses these to map host ports
LANDING_PORT=3000
WEB_PORT=3001

# ── Monitoring Ports ──────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── AI Service ────────────────────────────────────────────────────────
AI_SERVICE_PORT=8001
OLLAMA_PORT=11434
# Ollama model to use (see architecture doc for tiers)
# Minimum: llama3.2:3b | Recommended: llama3.1:8b | Optimal: qwen2.5:14b
OLLAMA_MODEL=llama3.1:8b
# Ollama base URL (change for external Ollama instances)
# OLLAMA_BASE_URL=http://ollama:11434
# AI Service log level: debug | info | warning | error
LOG_LEVEL=info

# ── Next.js Public URLs ───────────────────────────────────────────────
# Used for client-side API calls and CORS configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Authentication ─────────────────────────────────────────────────────
# NextAuth.js / Auth.js secret (REQUIRED)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# ── Brokerage / Exchange API Credentials (future) ─────────────────────
# These will be configured per-user, not globally.
# Listed here as a reference for upcoming integrations.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# INTERACTIVE_BROKERS_CLIENT_ID=
# INTERACTIVE_BROKERS_CLIENT_SECRET=

# ── Observability (future) ────────────────────────────────────────────
# OpenTelemetry endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=2108trade
